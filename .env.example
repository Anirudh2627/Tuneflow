# ============================================================
# TuneFlow environment
# Copy to .env (project root) and adjust. The backend reads these
# at startup (pydantic-settings, case-insensitive field names).
# ============================================================

# --- database ---
# docker-compose default:
DATABASE_URL=postgresql+psycopg2://tuneflow:tuneflow@localhost:5432/tuneflow
# local sqlite for quick experiments:
# DATABASE_URL=sqlite:///./data/tuneflow_dev.db

# --- backend ---
DEBUG=false
DB_ECHO=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
# comma-separated YAML config names (from configs/) used to build the ML engine
CONFIG_FILES=default.yaml
ARTIFACT_NAME=latest
SESSION_TIMEOUT_MINUTES=30

# --- frontend (vite dev proxy target) ---
VITE_BACKEND_URL=http://localhost:8000

# --- ML config overrides (dotted paths, double underscore separator) ---
# TUNEFLOW_OVERRIDE__hybrid__diversity__diversity_weight=0.5
# TUNEFLOW_OVERRIDE__collaborative__factors=128

# --- optional ---
# TUNEFLOW_DISABLE_ENGINE=1   # force DB-popularity fallback (used by tests)
# TUNEFLOW_ROOT=/path/to/tuneflow
